# Environment variables for POS and Inventory System
# Copy this file to .env and fill in actual values (do NOT commit .env with secrets)

# Database (Postgres recommended in production)
DATABASE_URL=postgresql://user:password@localhost:5432/pos_inventory_db

# JWT
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Default superadmin (example)
DEFAULT_SUPERADMIN_USERNAME=superadmin
DEFAULT_SUPERADMIN_PASSWORD=change_me

# Paynow
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key
PAYNOW_RETURN_URL=http://localhost:8000/paynow/callback
PAYNOW_RESULT_URL=http://localhost:8000/paynow/callback

# Optional monitoring
SENTRY_DSN=

# Feature Flags (for gradual rollouts and A/B testing)
# Set to 'true' or 'false' to override defaults

# Core sync features
FEATURE_SYNC_ENABLED=true
FEATURE_OFFLINE_MODE_ENABLED=true
FEATURE_CONFLICT_RESOLUTION_ENABLED=true
FEATURE_BULK_SYNC_ENABLED=false

# Authentication features
FEATURE_OFFLINE_AUTH_ENABLED=true
FEATURE_SECURE_CREDENTIAL_STORAGE=true

# Store management features
FEATURE_MULTI_STORE_ENABLED=true
FEATURE_STORE_SWITCHING_ENABLED=true
FEATURE_ROLE_BASED_ACCESS_ENABLED=true

# Analytics features
FEATURE_ANALYTICS_ENABLED=true
FEATURE_REAL_TIME_ANALYTICS=false

# Admin features
FEATURE_ADMIN_DASHBOARD_ENABLED=true
FEATURE_AUDIT_LOGGING_ENABLED=true

# Experimental features (keep disabled in production)
FEATURE_EXPERIMENTAL_UI_ENABLED=false
FEATURE_ADVANCED_REPORTING_ENABLED=false