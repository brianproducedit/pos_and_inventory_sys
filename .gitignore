# Root .gitignore for project

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
backend/venv/
**/venv/
.env
*.env
.env.*

# Database files
*.sqlite
*.db
**/*.sqlite
**/*.db

# IDEs
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Flutter builds
**/build/
.flutter-plugins
.packages
.pub-cache/

# Signing (NEVER commit)
*.jks
*.keystore
key.properties
keystore/

# Release artifacts
*.apk
*.aab

# Generated env (contains URLs, may contain secrets)
**/env.g.dart
